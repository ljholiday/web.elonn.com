APP_ENV=production
# Possible values: local, development, dev, testing, production
APP_DEBUG=false
APP_URL=https://web.elonn.com

ELONN_API_BASE_URL=https://api.elonn.com
ELONN_COOKIE_DOMAIN=.elonn.com
ELONN_WORLD_BASE_URL=https://world.elonn.com

# --- Service token: calling out to World (staged, not yet wired) ---------
# Reserved for web.elonn.local calling world.elonn.local as an authenticated
# service, mirroring the World->Mind and Mind->Find pattern. Present in
# .env on both this repo and world.elonn.local as of 2026-07-20, but NOT
# YET referenced by either repo's code — not currently enforced.
# When wired up: ELONN_WORLD_SERVICE_TOKEN must match world.elonn.local's
# ELONN_WEB_SERVICE_TOKEN exactly, in every environment.
ELONN_WORLD_SERVICE_CALLER=web.elonn
ELONN_WORLD_SERVICE_TOKEN=
