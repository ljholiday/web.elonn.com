APP_ENV=local
# Possible values: local, development, dev, testing, production
APP_DEBUG=false
APP_URL=https://web.elonn.local

# --- API ---------------------------------------------------------------
# Web owns the browser login surface. API authenticates the member and issues
# the elonn_api_token cookie consumed by the runtime.
ELONN_API_BASE_URL=https://api.elonn.local

# --- Browser cookie ----------------------------------------------------
# Must match the cookie domain API uses when setting elonn_api_token.
ELONN_COOKIE_DOMAIN=.elonn.local

# --- World -------------------------------------------------------------
# Web sends canonical Runtime-World Calls directly to World.
ELONN_WORLD_BASE_URL=https://world.elonn.local

# --- Service token: verifying inbound calls -----------------------------
# Checks incoming calls claiming to be admin.elonn.local.
# Must match admin.elonn.local's ELONN_WEB_SERVICE_TOKEN exactly, in every
# environment.
ELONN_ADMIN_SERVICE_TOKEN=
